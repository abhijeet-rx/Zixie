# Local development: point this at a MongoDB instance you control.
MONGODB_URI=mongodb://127.0.0.1:27017/zixie

# Replace with a unique random value of at least 32 characters.
JWT_SECRET=replace-this-with-a-random-secret-of-32-characters-or-more

NODE_ENV=development
PORT=4000
CLIENT_ORIGINS=http://localhost:3000

# Leave empty for local Vite proxying. Set to the deployed API origin in Vercel.
# VITE_API_BASE_URL=https://api.example.com
