{
  "name": "zixie",
  "version": "0.1.0",
  "description": "Real-time Code Plagiarism, Collusion, and AI Detection Platform for Technical Assessments",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "npm run --workspaces --if-present build",
    "test": "vitest run",
    "test:watch": "vitest",
    "predev": "kill-port 3000 4000 || exit 0",
    "dev": "concurrently -n \"API,WEB\" -c \"magenta,cyan\" \"npm run dev:server\" \"npm run dev:client\"",
    "dev:server": "npm run --workspace=@zixie/server dev",
    "dev:client": "npm run --workspace=@zixie/client dev"
  },
  "devDependencies": {
    "concurrently": "^9.1.2",
    "kill-port": "^2.0.1",
    "typescript": "^5.7.3",
    "vitest": "^3.0.7"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "author": "Abhijeet Singh",
  "license": "MIT"
}
